# Copie este arquivo para .env e preencha SOMENTE se quiser que o robo envie o e-mail de verdade.
# Sem estas variaveis o robo funciona normalmente e salva o e-mail em saida/emails/resumo.eml.
# O arquivo .env esta no .gitignore e nunca deve ir para o repositorio.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=robo@vivabairro.invalid
EMAIL_DESTINO=zeladoria@vivabairro.invalid
