# Copie para .env e use: python app.py --env-file .env
# Somente limites públicos. A chave NÃO pertence a este arquivo.
# Modelos e chave: %LOCALAPPDATA%/VivaBairroVoz/.env (não é alterado pelo app).
VIVABAIRRO_PORT=7860
VIVABAIRRO_MAX_AUDIO_SECONDS=60
VIVABAIRRO_MAX_AUDIO_MB=10
VIVABAIRRO_HISTORY_TURNS=6
VIVABAIRRO_SESSION_REQUESTS=30
VIVABAIRRO_MAX_OUTPUT_TOKENS=300
VIVABAIRRO_MAX_RESPONSE_CHARS=900
VIVABAIRRO_TIMEOUT_SECONDS=45
VIVABAIRRO_RETRIES=0
VIVABAIRRO_AUTO_TEST_CALLS=12
VIVABAIRRO_RETENTION_SECONDS=600
VIVABAIRRO_TTS_MAX_TOKENS=1500
